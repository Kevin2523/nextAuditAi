# =============================================================================
# NextAudit AI — Backend Environment Variables
# =============================================================================
# Copia este archivo como .env y ajusta los valores según tu entorno:
#   cp .env.example .env
# =============================================================================

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
CORS_ORIGIN=http://localhost:4200
APP_PUBLIC_URL=http://localhost:4200
DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000001

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgresql://nextaudit:nextaudit@localhost:5432/nextaudit?schema=core

# ─── Authentication / JWT ────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# ─── WebAuthn / Passkeys ─────────────────────────────────────────────────────
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:4200

# ─── SMTP / Email (Password Reset) ───────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@nextaudit.local

# ─── Integration: Fleet Device Management ────────────────────────────────────
FLEET_BASE_URL=
FLEET_TLS_REJECT_UNAUTHORIZED=true
FLEET_API_TOKEN=
FLEET_EMAIL=
FLEET_PASSWORD=

# ─── Integration: n8n Workflow Automation ────────────────────────────────────
N8N_BASE_URL=
N8N_API_KEY=
N8N_EMAIL=
N8N_PASSWORD=

# ─── Integration: n8n Alert Webhook ─────────────────────────────────────────
N8N_WEBHOOK_SECRET=change-me-to-a-random-webhook-secret

# ─── Integration: Flowise AI Chat ────────────────────────────────────────────
FLOWISE_BASE_URL=
FLOWISE_CHATFLOW_ID=
FLOWISE_API_KEY=

# ─── Dev / Seed (opcional, solo para entorno local) ─────────────────────────
DEV_USER_EMAIL=admin@nextaudit.local
DEV_USER_PASSWORD=NextAuditDev123!
DEV_USER_NAME=Administrador Local
DEV_USER_ROLE=super_admin
